{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode": {
      "options": {},
    },
  },
  "permission": {
    "edit": {
      "packages/opencode/migration/*": "deny",
    },
  },
  "mcp": {
    "media": {
      "type": "local",
      "command": ["bun", "./packages/media-mcp/bin/media-mcp"],
    },
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
