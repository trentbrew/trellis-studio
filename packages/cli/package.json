  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trentbrew/trellis-studio.git",
    "directory": "packages/cli"
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "turtlecode-backend-darwin-arm64": "0.3.72",
    "turtlecode-backend-darwin-x64": "0.3.72",
    "turtlecode-backend-darwin-x64-baseline": "0.3.72",
    "turtlecode-backend-linux-arm64": "0.3.72",
    "turtlecode-backend-linux-arm64-musl": "0.3.72",
    "turtlecode-backend-linux-x64": "0.3.72",
    "turtlecode-backend-linux-x64-baseline": "0.3.72",
    "turtlecode-backend-linux-x64-baseline-musl": "0.3.72",
    "turtlecode-backend-linux-x64-musl": "0.3.72",
    "turtlecode-backend-windows-arm64": "0.3.72",
    "turtlecode-backend-windows-x64": "0.3.72",
    "turtlecode-backend-windows-x64-baseline": "0.3.72"
  },
  "devDependencies": {
    "bun-types": "latest"
  }
