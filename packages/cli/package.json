{
  "name": "turtlecode",
  "version": "0.3.72",
  "description": "AI-powered creative workspace — launch with npx turtlecode",
  "type": "module",
  "bin": {
    "turtlecode": "./bin/cli.mjs"
  },
  "files": [
    "bin/",
    "assets/"
  ],
  "scripts": {
    "build": "bun script/build.ts",
    "test": "bun test --timeout 30000"
  },
  "keywords": [
    "ai",
    "creative",
    "workspace",
    "code",
    "editor",
    "graph",
    "trellis"
