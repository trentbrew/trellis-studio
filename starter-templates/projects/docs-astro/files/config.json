{
  "$schema": "https://opencode.ai/config.json",
  "projections": {
    "workspaceType": "docs",
    "pinned": ["notes", "articles", "content", "posts"]
  },
  "preview": {
    "services": {
      "docs": {
        "port": 4321,
        "type": "web",
        "command": "bun install && bun run dev",
        "url": "http://localhost:4321"
      }
    }
  }
}
